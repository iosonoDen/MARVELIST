# MARVELIST environment variables
# Copy this file to .env.local and fill in your values

# The Movie Database (TMDB) credential, used for cast photos and English posters.
# Either the "API Key" (v3, 32 characters) or the "API Read Access Token" (v4, long, starts with eyJ) works.
# On Vercel: Project Settings → Environment Variables → TMDB_API_KEY, then redeploy.
TMDB_API_KEY=

# Reserved for future use (optional cloud sync):
# KV_REST_API_URL=""
# KV_REST_API_TOKEN=""
